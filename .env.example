# JanSetu AI Environment Configuration
# Set MOCK_MODE=true for offline development and instant zero-latency testing
MOCK_MODE=true

# Groq API for ultra-fast Whisper ASR & Llama-3.3-70b-versatile Agent
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (Alternative Indian Vernacular Voice & Translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM Configuration (OpenAI-compatible endpoint, e.g. Groq, OpenAI, or Ollama)
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Vision LLM (for OCR & Document verification, e.g. llama-3.2-11b-vision-preview or gpt-4o-mini)
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://api.groq.com/openai/v1
VISION_MODEL=llama-3.2-11b-vision-preview
